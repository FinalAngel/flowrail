{
  "name": "flowrail",
  "version": "0.4.0",
  "description": "Guardrails for Claude Code that hold. A PreToolUse hook parses every command before it runs, the agent cannot switch it off, and `flowrail audit` replays your past sessions to show what it would have caught. Zero deps, no cloud, MIT.",
  "type": "module",
  "bin": {
    "flowrail": "bin/flowrail.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./api": "./src/api.js",
    "./core/audit.js": "./src/core/audit.js",
    "./core/doctor.js": "./src/core/doctor.js",
    "./core/hooks.js": "./src/core/hooks.js",
    "./core/init.js": "./src/core/init.js",
    "./core/journal.js": "./src/core/journal.js",
    "./core/paths.js": "./src/core/paths.js",
    "./core/redlines.js": "./src/core/redlines.js",
    "./core/util.js": "./src/core/util.js",
    "./core/verify.js": "./src/core/verify.js",
    "./core/workspace.js": "./src/core/workspace.js",
    "./core/builtins.js": "./src/guard/builtins.js",
    "./cli/main.js": "./src/cli/main.js",
    "./cli/setup.js": "./src/cli/setup.js",
    "./cli/ui.js": "./src/cli/ui.js",
    "./guard/state.js": "./src/guard/state.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "demo",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node bin/flowrail.js check",
    "corpus": "node scripts/corpus-stats.js"
  },
  "keywords": [
    "claude-code",
    "claude",
    "guardrails",
    "hooks",
    "pretooluse",
    "agent-safety",
    "llm-safety",
    "ai-agents",
    "coding-agents",
    "mcp",
    "git",
    "security",
    "local-first",
    "cli",
    "developer-tools",
    "flowrail"
  ],
  "homepage": "https://github.com/FinalAngel/flowrail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FinalAngel/flowrail.git",
    "directory": "packages/flowrail"
  },
  "bugs": {
    "url": "https://github.com/FinalAngel/flowrail/issues"
  },
  "license": "MIT"
}
