{
  "name": "flowrail-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "flowrail-monorepo",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@finalangel/flowrail-os": {
      "resolved": "packages/flowrail-os",
      "link": true
    },
    "node_modules/flowrail": {
      "resolved": "packages/flowrail",
      "link": true
    },
    "packages/flowrail": {
      "version": "0.4.2",
      "license": "MIT",
      "bin": {
        "flowrail": "bin/flowrail.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/flowrail-os": {
      "name": "@finalangel/flowrail-os",
      "version": "0.4.2",
      "license": "MIT",
      "dependencies": {
        "flowrail": "0.4.2"
      },
      "bin": {
        "flowrail-os": "bin/flowrail-os.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
