{
  "name": "flowrail-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "flowrail-monorepo",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@flowrail/control-room": {
      "resolved": "packages/control-room",
      "link": true
    },
    "node_modules/flowrail": {
      "resolved": "packages/flowrail",
      "link": true
    },
    "packages/control-room": {
      "name": "@flowrail/control-room",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "flowrail": "0.1.0"
      },
      "bin": {
        "flowrail-room": "bin/flowrail-room.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/flowrail": {
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "flowrail": "bin/flowrail.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
